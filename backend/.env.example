# Copy to .env for local development. Never commit real secrets.
APP_ENV=local

# Logging: JSON lines by default; set LOG_JSON=false for human-readable console output.
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL (compose publishes it on POSTGRES_PORT, default 55432)
DATABASE_URL=postgresql+psycopg://gri:gri@localhost:55432/gri

# Redis (compose publishes it on REDIS_PORT, default 6379)
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (compose runs MinIO on MINIO_PORT, default 9000;
# the minio-init service creates S3_BUCKET)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-dev-password
S3_BUCKET=gri-kpi

# Per-dependency timeout for GET /health/ready
HEALTH_CHECK_TIMEOUT_SECONDS=2
